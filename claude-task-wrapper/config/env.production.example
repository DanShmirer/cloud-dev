# Claude Task Wrapper - Production Environment Configuration
#
# SECURITY NOTES:
# - NEVER commit this file with actual values
# - Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Rotate API keys regularly
# - Each production instance should have unique credentials where possible
#
# Copy to .env.production and use environment-specific secrets injection

# Environment identifier (MUST be set correctly)
ENVIRONMENT=production

# =============================================================================
# SECRETS (Inject via secrets manager, never hardcode!)
# =============================================================================

# Anthropic API Key - PRODUCTION KEY ONLY
# - Create a dedicated production key
# - Set usage limits and alerts in Anthropic console
# - Rotate regularly
ANTHROPIC_API_KEY=

# Redis password (REQUIRED for production)
REDIS_PASSWORD=

# Webhook secret for validating callbacks (REQUIRED)
WEBHOOK_SECRET=

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_URL=redis://redis:6379
RESULT_TTL_DAYS=30
SESSION_TTL_HOURS=48

# =============================================================================
# Claude Code Configuration
# =============================================================================

CLAUDE_BINARY=/usr/local/bin/claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_MAX_TURNS=100
CLAUDE_TIMEOUT=600

# =============================================================================
# Worker Configuration
# =============================================================================

WORKER_MODE=all
MAX_CONCURRENT_TASKS=4
POLL_TIMEOUT=5
WORKSPACE_ROOT=/workspace
WORKSPACES_ROOT=/workspaces
CLEANUP_AFTER_HOURS=48

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=WARNING

# CORS - EXPLICIT ORIGINS ONLY (required for production)
# List your production domains, comma-separated
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Rate limiting (stricter for production)
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_PERIOD=60

# =============================================================================
# OpenTelemetry Configuration
# =============================================================================

OTEL_SERVICE_NAME=claude-task-wrapper
OTEL_ENVIRONMENT=production
OTEL_EXPORTER_TYPE=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# For external observability backends (Datadog, Honeycomb, etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY

OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true
OTEL_TRACE_SAMPLE_RATE=0.1

CLAUDE_CODE_ENABLE_TELEMETRY=1
