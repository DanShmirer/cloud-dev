# Claude Task Wrapper - Staging Environment Configuration
# Copy to .env.staging and fill in your values
# Use staging-specific API keys!

# Environment identifier (MUST be set correctly)
ENVIRONMENT=staging

# =============================================================================
# SECRETS (Never commit actual values!)
# =============================================================================

# Anthropic API Key - USE STAGING-SPECIFIC KEY
# Create a separate key for staging at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Redis password (recommended for staging)
REDIS_PASSWORD=

# Webhook secret for validating callbacks
WEBHOOK_SECRET=

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_URL=redis://redis:6379
RESULT_TTL_DAYS=7
SESSION_TTL_HOURS=24

# =============================================================================
# Claude Code Configuration
# =============================================================================

CLAUDE_BINARY=/usr/local/bin/claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_MAX_TURNS=50
CLAUDE_TIMEOUT=300

# =============================================================================
# Worker Configuration
# =============================================================================

WORKER_MODE=all
MAX_CONCURRENT_TASKS=2
POLL_TIMEOUT=5
WORKSPACE_ROOT=/workspace
WORKSPACES_ROOT=/workspaces
CLEANUP_AFTER_HOURS=12

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# CORS - Explicit origins required for staging
# Replace with your staging domain(s)
CORS_ORIGINS=https://staging.yourdomain.com,https://staging-admin.yourdomain.com

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# =============================================================================
# OpenTelemetry Configuration
# =============================================================================

OTEL_SERVICE_NAME=claude-task-wrapper
OTEL_ENVIRONMENT=staging
OTEL_EXPORTER_TYPE=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true
CLAUDE_CODE_ENABLE_TELEMETRY=1
