# Claude Task Wrapper - Development Environment Configuration
# Copy to .env.development and fill in your values

# Environment identifier (MUST be set correctly)
ENVIRONMENT=development

# =============================================================================
# SECRETS (Never commit actual values!)
# =============================================================================

# Anthropic API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-development-api-key-here

# Redis password (optional in dev)
# REDIS_PASSWORD=

# Webhook secret for validating callbacks (optional in dev)
# WEBHOOK_SECRET=

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_URL=redis://localhost:6379
RESULT_TTL_DAYS=7
SESSION_TTL_HOURS=24

# =============================================================================
# Claude Code Configuration
# =============================================================================

CLAUDE_BINARY=claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_MAX_TURNS=50
CLAUDE_TIMEOUT=300

# =============================================================================
# Worker Configuration
# =============================================================================

WORKER_MODE=all
MAX_CONCURRENT_TASKS=1
POLL_TIMEOUT=5
WORKSPACE_ROOT=/workspace
WORKSPACES_ROOT=/workspaces
CLEANUP_AFTER_HOURS=24

# =============================================================================
# API Configuration
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=DEBUG

# CORS - Allow all origins in development
CORS_ORIGINS=*

# Rate limiting (relaxed for dev)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

# =============================================================================
# OpenTelemetry Configuration (optional in dev)
# =============================================================================

OTEL_SERVICE_NAME=claude-task-wrapper
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_TYPE=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
CLAUDE_CODE_ENABLE_TELEMETRY=1
